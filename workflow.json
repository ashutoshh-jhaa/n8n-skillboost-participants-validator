      "parameters": {
        "jsCode": "return items.map(item => {\n  const email = item.json[\"Email Address\"]?.trim() || \"\";\n  const profileEmail = item.json[\"skill boost email\"]?.trim() || \"\";\n  const url = item.json[\"skill boost profile\"]?.trim() || \"\";\n\n  const isValidEmail = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n  const isValidProfileEmail = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(profileEmail);\n  const isValidUrl = url.includes(\"cloudskillsboost.google/public_profiles\");\n\n  const isValid = isValidEmail && isValidProfileEmail && isValidUrl;\n  item.json.isValid = isValid;\n  return item;\n});"
      },
